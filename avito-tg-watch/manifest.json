{
  "manifest_version": 3,
  "name": "Авито → ТГ · 29way",
  "version": "0.4.1",
  "minimum_chrome_version": "120",
  "description": "Уведомления только о росте выбранного счётчика непрочитанных Авито.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.telegram.org/*",
    "https://www.avito.ru/*",
    "https://avito.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.avito.ru/*",
        "https://avito.ru/*"
      ],
      "js": [
        "picker.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}